{
  "name": "applyant-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "applyantd and the applyant CLI",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "applyant": "./src/cli/index.ts",
    "applyantd": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "cli": "node src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:generate": "drizzle-kit generate",
    "fixtures:record": "node scripts/fixtures-record.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.3",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.3",
    "patchright": "^1.63.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@biomejs/biome": "^2.5.14",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
