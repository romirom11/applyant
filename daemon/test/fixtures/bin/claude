#!/usr/bin/env node
// A stand-in for the `claude` CLI that speaks just enough of the Agent SDK's stream-json
// protocol. It records how it was started, so tests can check the SDK spawned exactly the
// path Applyant passed (and not the binary bundled in the SDK's npm package).
//
//   FAKE_CLAUDE_ARGV    file to append {argv, cwd, env} to, one JSON line per start
//   FAKE_CLAUDE_MODE    ok (default) | limit | limit-event | error | exit
//   FAKE_CLAUDE_OUTPUT  JSON file with the structured output to return in ok mode. A file of
//                       the form {"$bySchema": {"<property>": output, ...}} answers by role:
//                       the first property the --json-schema has at its top level picks it.
(async () => {
  const fs = await import('node:fs');
  const env = process.env;
  if (env.FAKE_CLAUDE_ARGV) {
    fs.appendFileSync(
      env.FAKE_CLAUDE_ARGV,
      `${JSON.stringify({
        argv: process.argv,
        cwd: process.cwd(),
        env: Object.keys(env).filter((k) => k.startsWith('CLAUDE')).sort(),
      })}\n`,
    );
  }
  // The setup status checks (cli-status.ts).
  const [first, second] = process.argv.slice(2);
  if (first === '--version') {
    process.stdout.write('9.9.9 (Fake Claude)\n');
    return;
  }
  if (first === 'auth' && second === 'status') {
    process.stdout.write(`${JSON.stringify({ loggedIn: env.FAKE_CLAUDE_SIGNED_OUT !== '1' })}\n`);
    process.exitCode = env.FAKE_CLAUDE_SIGNED_OUT === '1' ? 1 : 0;
    return;
  }
  const mode = env.FAKE_CLAUDE_MODE || 'ok';
  if (mode === 'exit') {
    process.stderr.write("You've hit your weekly limit · resets Oct 3, 9am\n");
    process.exit(1);
  }
  const session = 'fake-session';
  const send = (m) => process.stdout.write(`${JSON.stringify(m)}\n`);
  const usage = { input_tokens: 1200, output_tokens: 300 };
  const modelUsage = {
    'claude-sonnet-5': {
      inputTokens: 1200,
      outputTokens: 300,
      cacheReadInputTokens: 0,
      cacheCreationInputTokens: 0,
      webSearchRequests: 0,
      costUSD: 0.01,
      contextWindow: 1000000,
      maxOutputTokens: 64000,
    },
  };
  const result = (extra) => ({
    type: 'result',
    duration_ms: 20,
    duration_api_ms: 15,
    num_turns: 1,
    stop_reason: 'end_turn',
    total_cost_usd: 0.01,
    usage,
    modelUsage,
    permission_denials: [],
    uuid: '00000000-0000-4000-8000-000000000001',
    session_id: session,
    ...extra,
  });
  const reply = () => {
    send({
      type: 'system',
      subtype: 'init',
      model: 'claude-sonnet-5',
      session_id: session,
      tools: [],
      mcp_servers: [],
      uuid: '00000000-0000-4000-8000-000000000002',
    });
    if (mode === 'limit' || mode === 'limit-event') {
      const text = "You've hit your session limit · resets 3:45pm";
      if (mode === 'limit-event') {
        send({
          type: 'rate_limit_event',
          rate_limit_info: { status: 'rejected', resetsAt: 1790600000, rateLimitType: 'five_hour' },
          uuid: '00000000-0000-4000-8000-000000000003',
          session_id: session,
        });
      }
      send({
        type: 'assistant',
        message: { role: 'assistant', content: [{ type: 'text', text }] },
        parent_tool_use_id: null,
        error: 'rate_limit',
        uuid: '00000000-0000-4000-8000-000000000004',
        session_id: session,
      });
      send(result({ subtype: 'success', is_error: true, result: text }));
      return;
    }
    if (mode === 'error') {
      send(result({ subtype: 'error_during_execution', is_error: true, errors: ['boom'] }));
      return;
    }
    let output = JSON.parse(fs.readFileSync(env.FAKE_CLAUDE_OUTPUT, 'utf8'));
    if (output && output.$bySchema) {
      const i = process.argv.indexOf('--json-schema');
      const props = i > 0 ? Object.keys(JSON.parse(process.argv[i + 1]).properties ?? {}) : [];
      const key = Object.keys(output.$bySchema).find((k) => props.includes(k));
      if (!key) {
        send(result({ subtype: 'error_during_execution', is_error: true, errors: [`no fake output for ${props}`] }));
        return;
      }
      output = output.$bySchema[key];
    }
    send(result({ subtype: 'success', is_error: false, result: '', structured_output: output }));
  };

  let buf = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (chunk) => {
    buf += chunk;
    for (let i = buf.indexOf('\n'); i >= 0; i = buf.indexOf('\n')) {
      const line = buf.slice(0, i).trim();
      buf = buf.slice(i + 1);
      if (!line) continue;
      const m = JSON.parse(line);
      if (m.type === 'control_request') {
        send({
          type: 'control_response',
          response: { subtype: 'success', request_id: m.request_id, response: {} },
        });
      } else if (m.type === 'user') {
        reply();
      }
    }
  });
  process.stdin.on('end', () => process.exit(0));
})();
