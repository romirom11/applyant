<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- applyantd as a launch agent, registered by the app through SMAppService. KeepAlive:
     launchd restarts it after a crash. Registration.swift writes the same keys to
     ~/Library/LaunchAgents when SMAppService refuses the ad-hoc signed bundle. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.applyant.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/applyantd</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Browser automation and agent runs: no background throttling. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.applyant.app</string>
	</array>
</dict>
</plist>
